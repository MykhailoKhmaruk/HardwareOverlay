<Application x:Class="HardwareOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:loc="clr-namespace:HardwareOverlay.Localization"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="{Binding Path=[Tray_Tooltip], Source={x:Static loc:Loc.Instance}}"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="HW" Foreground="White" Background="#FF2D7DD2" />
            </tb:TaskbarIcon.IconSource>

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding Path=[Tray_Settings], Source={x:Static loc:Loc.Instance}}" Click="OnSettingsClick" />
                    <Separator />
                    <MenuItem Header="{Binding Path=[Tray_Exit], Source={x:Static loc:Loc.Instance}}" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

    </Application.Resources>
</Application>
