<Window x:Class="HardwareOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HardwareOverlay.ViewModels"
        xmlns:models="clr-namespace:HardwareOverlay.Models"
        xmlns:conv="clr-namespace:HardwareOverlay.Converters"
        xmlns:loc="clr-namespace:HardwareOverlay.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{Binding Path=[Win_Settings], Source={x:Static loc:Loc.Instance}}"
        Width="580" Height="700" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:NullToEmptyStringConverter x:Key="NullToEmpty" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#55000000" BorderThickness="1" CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Hyperlink NavigateUri="https://www.linkedin.com/in/mykhailo-khmaruk-5b9522140"
                       RequestNavigate="OnLinkNavigate">LinkedIn</Hyperlink>
        </TextBlock>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding Path=[Btn_Reset], Source={x:Static loc:Loc.Instance}}"
                        Padding="10,4" Margin="0,0,8,0"
                        Command="{Binding ResetToDefaultsCommand}" />
                <Button Content="{Binding Path=[Btn_Close], Source={x:Static loc:Loc.Instance}}"
                        Padding="10,4" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=[Lbl_Language], Source={x:Static loc:Loc.Instance}}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="130"
                          ItemsSource="{Binding LanguageOptions}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Settings.Language}" />
            </StackPanel>
            <TextBlock Text="{Binding Path=[Note_AutoSave], Source={x:Static loc:Loc.Instance}}"
                       Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" />
        </DockPanel>

        <TabControl>

            <!-- ===================== METRICS ===================== -->
            <TabItem Header="{Binding Path=[Tab_Metrics], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding Settings.Metrics}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MetricSettings}">
                                <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="4"
                                        Padding="8" Margin="0,0,0,6">
                                    <StackPanel>

                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="▲" Width="24" Margin="2,0"
                                                        ToolTip="{Binding Path=[Btn_Up], Source={x:Static loc:Loc.Instance}}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="▼" Width="24" Margin="2,0"
                                                        ToolTip="{Binding Path=[Btn_Down], Source={x:Static loc:Loc.Instance}}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static conv:LocConverter.Instance}">
                                                            <Binding Path="NameKey" />
                                                            <Binding Source="{x:Static loc:Loc.Instance}" Path="Current" />
                                                            <Binding />
                                                            <Binding Path="CustomName" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </CheckBox>
                                        </DockPanel>

                                        <Grid Margin="24,8,0,0"
                                              Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Path=[Lbl_Prefix], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                     Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="1" Text="{Binding Path=[Lbl_Name], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="2" Text="{Binding Path=[Lbl_Color], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                                <Border Width="22" Height="22" CornerRadius="3"
                                                        BorderBrush="#55000000" BorderThickness="1"
                                                        Background="{Binding Color}" />
                                                <TextBox Width="90" Margin="6,0" VerticalContentAlignment="Center">
                                                    <TextBox.Text>
                                                        <Binding Path="Color" UpdateSourceTrigger="PropertyChanged">
                                                            <Binding.ValidationRules>
                                                                <conv:ColorStringValidationRule />
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>
                                                </TextBox>
                                                <ItemsControl VerticalAlignment="Center"
                                                              ItemsSource="{Binding DataContext.PaletteColors, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource SwatchButton}"
                                                                    Background="{Binding}"
                                                                    ToolTip="{Binding}"
                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    Click="OnPaletteColorClick" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <TextBlock Grid.Row="3" Text="{Binding Path=[Lbl_Font], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                                                <TextBlock DockPanel.Dock="Right" Width="45" TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding FontSize, StringFormat={}{0:F0} px}" />
                                                <Slider Minimum="8" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center" Value="{Binding FontSize}" />
                                            </DockPanel>

                                            <TextBlock Grid.Row="4" Text="{Binding Path=[Lbl_Disk], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding SupportsHardwareSelection, Converter={StaticResource BoolToVis}}" />
                                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4"
                                                      Visibility="{Binding SupportsHardwareSelection, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding DataContext.DiskOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding HardwareId, Converter={StaticResource NullToEmpty}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:DiskOption}">
                                                        <TextBlock>
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{x:Static conv:LocConverter.Instance}">
                                                                    <Binding Path="NameKey" />
                                                                    <Binding Source="{x:Static loc:Loc.Instance}" Path="Current" />
                                                                    <Binding Path="DisplayName" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Row="4" Text="{Binding Path=[Lbl_MbSensor], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}"
                                                       Visibility="{Binding SupportsSensorSelection, Converter={StaticResource BoolToVis}}" />
                                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4"
                                                      Visibility="{Binding SupportsSensorSelection, Converter={StaticResource BoolToVis}}"
                                                      ItemsSource="{Binding DataContext.SensorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding HardwareId, Converter={StaticResource NullToEmpty}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SensorOption}">
                                                        <TextBlock>
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{x:Static conv:LocConverter.Instance}">
                                                                    <Binding Path="NameKey" />
                                                                    <Binding Source="{x:Static loc:Loc.Instance}" Path="Current" />
                                                                    <Binding Path="Name" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,4"
                                                      Visibility="{Binding SupportsTotal, Converter={StaticResource BoolToVis}}"
                                                      IsChecked="{Binding ShowTotal}"
                                                      Content="{Binding Path=[Lbl_ShowTotal], Source={x:Static loc:Loc.Instance}}" />

                                            <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,4"
                                                      Visibility="{Binding SupportsTotal, Converter={StaticResource BoolToVis}}"
                                                      IsChecked="{Binding ShowInGb}"
                                                      Content="{Binding Path=[Lbl_ShowInGb], Source={x:Static loc:Loc.Instance}}" />
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="4"
                            Padding="8" Margin="4,0,4,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Path=[Lbl_Disks], Source={x:Static loc:Loc.Instance}}"
                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding Path=[Lbl_DiskAlias], Source={x:Static loc:Loc.Instance}}"
                                           Foreground="Gray" FontSize="11" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DiskOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiskOption}">
                                        <Grid Margin="0,2"
                                              Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBox Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                                     Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== OVERLAY ===================== -->
            <TabItem Header="{Binding Path=[Tab_Overlay], Source={x:Static loc:Loc.Instance}}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Path=[Lbl_BgOpacity], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Width="45" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.BackgroundOpacity, StringFormat={}{0:P0}}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.BackgroundOpacity}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="{Binding Path=[Lbl_BgColor], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                        <Border Width="22" Height="22" CornerRadius="3" BorderBrush="#55000000" BorderThickness="1"
                                Background="{Binding Settings.BackgroundColor}" />
                        <TextBox Width="90" Margin="6,0" VerticalContentAlignment="Center">
                            <TextBox.Text>
                                <Binding Path="Settings.BackgroundColor" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <conv:ColorStringValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="{Binding Path=[Lbl_TextOpacity], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Width="45" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.TextOpacity, StringFormat={}{0:P0}}" />
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.TextOpacity}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="3" Text="{Binding Path=[Lbl_AutoSize], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,6" IsChecked="{Binding Settings.AutoSize}" />

                    <TextBlock Grid.Row="4" Text="{Binding Path=[Lbl_Width], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4"
                             IsEnabled="{Binding Settings.AutoSize, Converter={StaticResource InverseBool}}"
                             Text="{Binding Settings.Width, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Row="5" Text="{Binding Path=[Lbl_Height], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,4"
                             IsEnabled="{Binding Settings.AutoSize, Converter={StaticResource InverseBool}}"
                             Text="{Binding Settings.Height, UpdateSourceTrigger=LostFocus}" />

                    <TextBlock Grid.Row="6" Text="{Binding Path=[Lbl_Corner], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="6" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4"
                              ItemsSource="{Binding CornerOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.Corner}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CornerOption}">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static conv:LocConverter.Instance}">
                                            <Binding Path="NameKey" />
                                            <Binding Source="{x:Static loc:Loc.Instance}" Path="Current" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="7" Text="{Binding Path=[Lbl_MarginX], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Width="45" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.MarginX, StringFormat={}{0:F0} px}" />
                        <Slider Minimum="0" Maximum="1000" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.MarginX}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="8" Text="{Binding Path=[Lbl_MarginY], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Width="45" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.MarginY, StringFormat={}{0:F0} px}" />
                        <Slider Minimum="0" Maximum="1000" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.MarginY}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="9" Text="{Binding Path=[Lbl_UpdateInterval], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,4">
                        <TextBlock DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Settings.UpdateIntervalMs, StringFormat={}{0} ms}" />
                        <Slider Minimum="250" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.UpdateIntervalMs}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Grid.Row="10" Text="{Binding Path=[Lbl_Monitors], Source={x:Static loc:Loc.Instance}}"
                               Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,8,0" />
                    <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,6,0,4">
                        <CheckBox IsChecked="{Binding Settings.ShowOnAllMonitors}" Margin="0,0,0,4"
                                  Content="{Binding Path=[Monitor_All], Source={x:Static loc:Loc.Instance}}" />
                        <ItemsControl ItemsSource="{Binding MonitorOptions}" Margin="18,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MonitorOption}">
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Path=[Monitor_Name], Source={x:Static loc:Loc.Instance}}" />
                                            <TextBlock Text="{Binding Number}" Margin="4,0,0,0" />
                                            <TextBlock Text="{Binding Resolution, StringFormat={}— {0}}" Margin="6,0,0,0" Foreground="Gray" />
                                            <TextBlock Text="{Binding Path=[Monitor_Primary], Source={x:Static loc:Loc.Instance}, StringFormat={}({0})}"
                                                       Margin="6,0,0,0" Foreground="Gray"
                                                       Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <CheckBox Grid.Row="11" Grid.ColumnSpan="2" Margin="0,8,0,0"
                              IsChecked="{Binding Settings.StartWithWindows}"
                              Content="{Binding Path=[Lbl_Autostart], Source={x:Static loc:Loc.Instance}}" />
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
